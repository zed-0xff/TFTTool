; object id 0 (page): x=0, y=0, w=480, h=272, name hash=0x703f6555
; flags=0x37, aph=127
; sta=2, pic=114
; 04d2c5:  00 00 00 00 ff ff ff ff                          |........|

; load
.org 0x4e745
    if global_14 != 0 then jump lbl_4e868
    local_6e25 = "挤出机或者喷嘴可能出现堵头或者挤出齿轮松动\r\r1、拧紧挤出机齿轮把手\r\r2、松开齿轮把手，拔出耗材查看是否出现磨损\r\r3、将耗材拔出，剪掉前端部分，点击「进料」查看是否堵头"
    jmp lbl_4f39c

lbl_4e868:
    if global_14 != 1 then jump lbl_4e9ae
    local_6e25 = "There may be a clog in the extruder or nozzle, or the extrusion gear may be loose.\r\r1. Tighten the extruder gear knob.\r\r2. Loosen the gear knob, pull out the filament to check for wear.\r\r3. Pull out the filament, cut off the front part, and click \"Feed\" to check for clogs."
    jmp lbl_4f39c

lbl_4e9ae:
    if global_14 != 2 then jump lbl_4eba9
    local_6e25 = "エクストルーダーまたはノズルに詰まりが発生している可能性があり、または押出ギアが緩んでいる可能性があります。\r\r1. エクストルーダーギアのノブを締める。\r\r2. ギアのノブを緩め、フィラメントを引き抜いて摩耗をチェックする。\r\r3. フィラメントを引き抜き、前端部分を切り取り、「送り」をクリックして詰まりをチェックする。"
    jmp lbl_4f39c

lbl_4eba9:
    if global_14 != 3 then jump lbl_4ed37
    local_6e25 = "Es kann ein Verstopfen im Extruder oder in der Düse vorliegen oder das Extrusionsrad kann locker sein.\r\r1. Den Extruder-Radknopf festziehen.\r\r2. Den Radknopf lösen, das Filament herausziehen und auf Abnutzung prüfen.\r\r3. Das Filament herausziehen, den vorderen Teil abschneiden und auf „Einführen“ klicken, um auf Verstopfungen zu prüfen."
    jmp lbl_4f39c

lbl_4ed37:
    if global_14 != 4 then jump lbl_4eebb
    local_6e25 = "Puede haber un atasco en la extrusora o en la boquilla, o el engranaje de extrusión puede estar flojo.\r\r1. Apriete el mango del engranaje de la extrusora.\r\r2. Afloje el mango del engranaje, saque el filamento para ver si hay desgaste.\r\r3. Saque el filamento, corte la parte delantera y haga clic en \"Alimentar\" para ver si hay atasco."
    jmp lbl_4f39c

lbl_4eebb:
    if global_14 != 5 then jump lbl_4f05a
    local_6e25 = "Il peut y avoir un bouchon dans l'extrudeuse ou la buse, ou l'engrenage d'extrusion peut être desserré.\r\r1. Serrer le bouton de l'engrenage de l'extrudeuse.\r\r2. Desserrer le bouton de l'engrenage, retirer le filament pour vérifier s'il y a usure.\r\r3. Retirer le filament, couper la partie avant et cliquer sur « Alimenter » pour vérifier s'il y a un bouchon."
    jmp lbl_4f39c

lbl_4f05a:
    if global_14 != 6 then jump lbl_4f1e4
    local_6e25 = "Pode haver um entupimento na extrusora ou na ponteira, ou a engrenagem de extrusão pode estar solta.\r\r1. Aperte o botão da engrenagem da extrusora.\r\r2. Solte o botão da engrenagem, retire o filamento para verificar se há desgaste.\r\r3. Retire o filamento, corte a parte da frente e clique em \"Alimentar\" para verificar se há entupimento."
    jmp lbl_4f39c

lbl_4f1e4:
    if global_14 != 7 then jump lbl_4f39c
    local_6e25 = "Potrebbe esserci un intasamento nell'estrusore o nell'ugello, oppure l'ingranaggio di estrusione potrebbe essere allentato.\r\r1. Stringere la manopola dell'ingranaggio dell'estrusore.\r\r2. Allentare la manopola dell'ingranaggio, estrarre il filamento per verificare se è usurato.\r\r3. Estrarre il filamento, tagliare la parte anteriore e fare clic su \"Alimenta\" per verificare se c'è un intasamento."

lbl_4f39c:
    if global_14 != 0 then jump lbl_4f3cf
    local_6dfe = "确定"
    jmp lbl_4f51c

lbl_4f3cf:
    if global_14 != 1 then jump lbl_4f3fe
    local_6dfe = "OK"
    jmp lbl_4f51c

lbl_4f3fe:
    if global_14 != 2 then jump lbl_4f431
    local_6dfe = "確定"
    jmp lbl_4f51c

lbl_4f431:
    if global_14 != 3 then jump lbl_4f460
    local_6dfe = "OK"
    jmp lbl_4f51c

lbl_4f460:
    if global_14 != 4 then jump lbl_4f494
    local_6dfe = "Aceptar"
    jmp lbl_4f51c

lbl_4f494:
    if global_14 != 5 then jump lbl_4f4c9
    local_6dfe = "D'accord"
    jmp lbl_4f51c

lbl_4f4c9:
    if global_14 != 6 then jump lbl_4f4f8
    local_6dfe = "OK"
    jmp lbl_4f51c

lbl_4f4f8:
    if global_14 != 7 then jump lbl_4f51c
    local_6dfe = "OK"

lbl_4f51c:
    doevents
    down
    up
    unload
    down
    up
    down
    up

