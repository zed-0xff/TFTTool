; object id 0 (page): x=0, y=0, w=480, h=272, name hash=0x3e2bf6f6
; flags=0x37, aph=127
; sta=2, pic=110
; 0539a2:  00 00 00 00 ff ff ff ff                          |........|

; load
.org 0x54e92
    if global_14 != 0 then jump lbl_5501a
    local_751c = "1.按住①处的把手。\r\r2.将耗材通过②耗材口将耗材置入送料辅助器中，直至在铁氟龙管看见耗材。\r\r3.通过按压③处的按钮，启动送料辅助器直至将耗材送至挤出机齿轮。\r\r4.确保耗材已经到挤出机齿轮处后，再点击“确定”进行挤出机耗材挤出。"
    local_7543 = "确定"
    jmp lbl_55ffe

lbl_5501a:
    if global_14 != 1 then jump lbl_55201
    local_751c = "1. Hold the handle at ①.\r\r2. Insert the filament through the filament inlet at ② into the feeding assist device.\r\r3. Once the green LED lights up and the filament is visible in the Teflon tube, press the button at ③ to start the feeding assist device until the filament reaches the extruder gear.\r\r4. After ensuring the filament has reached the extruder gear, click 'OK' to extrude the filament through the extruder."
    local_7543 = "OK"
    jmp lbl_55ffe

lbl_55201:
    if global_14 != 2 then jump lbl_55489
    local_751c = "1. ①のハンドルを押さえ。\r\r2. ②のフィラメント入口からフィラメントを送料補助器に入れます。\r\r3. 緑色のLEDが点灯し、テフロン管の中でフィラメントが見えるようになったら、③のボタンを押して送料補助器を起動し、フィラメントがエクストルーダーギアに届くまで続けます。\r\r4. フィラメントがエクストルーダーギアに届いたことを確認した後、「確定」をクリックしてエクストルーダーからフィラメントを押し出します。"
    local_7543 = "確定"
    jmp lbl_55ffe

lbl_55489:
    if global_14 != 3 then jump lbl_556a5
    local_751c = "1. Halten Sie den Griff an ①.\r\r2. Führen Sie das Filament durch die Filamenteinlassöffnung an ② in die Zuführhilfe ein.\r\r3. Sobald die grüne LED leuchtet und das Filament im Teflonschlauch sichtbar ist, drücken Sie die Taste an ③, um die Zuführhilfe zu starten, bis das Filament das Extruderrad erreicht.\r\r4. Nachdem Sie sichergestellt haben, dass das Filament das Extruderrad erreicht hat, klicken Sie auf 'OK', um das Filament durch den Extruder zu extrudieren."
    local_7543 = "OK"
    jmp lbl_55ffe

lbl_556a5:
    if global_14 != 4 then jump lbl_55910
    local_751c = "1. Sujete el mango en ①.\r\r2. Introduzca el filamento a través de la entrada de filamento en ② en el dispositivo de asistencia de alimentación.\r\r3. Una vez que el LED verde se encienda y el filamento sea visible en el tubo de teflón, presione el botón en ③ para iniciar el dispositivo de asistencia de alimentación hasta que el filamento llegue al engranaje de la extrusora.\r\r4. Después de asegurarse de que el filamento ha llegado al engranaje de la extrusora, haga clic en 'Aceptar' para extrudir el filamento a través de la extrusora."
    local_7543 = "Aceptar"
    jmp lbl_55ffe

lbl_55910:
    if global_14 != 5 then jump lbl_55b76
    local_751c = "1. Maintenez la poignée à ①.\r\r2. Insérez le filament par l'entrée de filament à ② dans le dispositif d'assistance d'alimentation.\r\r3. Une fois que le LED vert s'allume et que le filament est visible dans le tube en téflon, appuyez sur le bouton à ③ pour démarrer le dispositif d'assistance d'alimentation jusqu'à ce que le filament atteigne l'engrenage de l'extrudeuse.\r\r4. Après vous être assuré que le filament a atteint l'engrenage de l'extrudeuse, cliquez sur 'D'accord' pour extruder le filament à travers l'extrudeuse."
    local_7543 = "D'accord"
    jmp lbl_55ffe

lbl_55b76:
    if global_14 != 6 then jump lbl_55da1
    local_751c = "1. Segure a alça em ①.\r\r2. Insira o filamento através da entrada de filamento em ② no dispositivo de auxílio de alimentação.\r\r3. Assim que o LED verde acender e o filamento ficar visível no tubo de teflon, pressione o botão em ③ para iniciar o dispositivo de auxílio de alimentação até que o filamento chegue à engrenagem da extrusora.\r\r4. Depois de ter certeza de que o filamento chegou à engrenagem da extrusora, clique em 'OK' para extrudir o filamento pela extrusora."
    local_7543 = "OK"
    jmp lbl_55ffe

lbl_55da1:
    if global_14 != 7 then jump lbl_55ffe
    local_751c = "1. Tieni premuto la maniglia in ①.\r\r2. Inserisci il filamento attraverso l'ingresso del filamento in ② nel dispositivo di assistenza all'alimentazione.\r\r3. Una volta che il LED verde si accende e il filamento è visibile nel tubo in teflon, premi il pulsante in ③ per avviare il dispositivo di assistenza all'alimentazione fino a quando il filamento raggiunge l'ingranaggio dell'estrusore.\r\r4. Dopo esserti assicurato che il filamento ha raggiunto l'ingranaggio dell'estrusore, fai clic su 'OK' per estrudere il filamento attraverso l'estrusore."
    local_7543 = "OK"

lbl_55ffe:
    doevents
    down
    up
    unload
    down
    up
    down
    up
    down
    up
    down
    up
    down
    up
    down
    up
    down
    up
    down
    up
    down
    up

